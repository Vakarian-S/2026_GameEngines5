  <ItemDefinitionGroup>
    <ClCompile>
      <!--
        /sdl off, and only in this project.

        /sdl overwrites a pointer with a junk address as soon as it is deleted, so a stale
        pointer cannot be used again. The tests delete the same pointer twice on purpose, and
        under /sdl the second delete hands the monitor a wild address instead of a stale one.
        The monitor reads the header in front of the block to decide whether to refuse the free,
        and reading it at a wild address is an access violation. See "It does not survive a
        truly wild pointer" in the README.

        Everything else in the solution keeps /sdl. It is build\Common.props that turns it on.
      -->
      <SDLCheck>false</SDLCheck>
    </ClCompile>
  </ItemDefinitionGroup>
